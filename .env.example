# ReMind Server & Desktop App Environment Variables
# Copy this file to '.env' or set these variables in your deployment system

# Server HTTP Port (Default: 8080)
PORT=8080

# Server HTTP Host Binding (Default: 0.0.0.0)
HOST=0.0.0.0

# Application Environment (development, staging, production)
APP_ENV=development

# Path to Firebase Admin SDK Service Account JSON Key
GOOGLE_APPLICATION_CREDENTIALS=C:\Users\ozlem\.credentials\remind-service-account-key.json

# Optional: Path to JSON word import dataset for WordsImporter
WORDS_FILE_PATH=D:\Downloads\words.json
